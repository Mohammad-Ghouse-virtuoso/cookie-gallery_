# Git secrets patterns for Cookie Gallery
# This file contains patterns to detect secrets in commits

# AWS Keys
AKIA[0-9A-Z]{16}

# Private Keys
-----BEGIN (RSA |DSA |EC )?PRIVATE KEY-----

# Slack Tokens
xox[baprs]-[0-9]{10,12}-[0-9]{10,12}-[a-zA-Z0-9]{24,32}

# Stripe Live Keys
sk_live_[0-9a-zA-Z]{24,}
pk_live_[0-9a-zA-Z]{24,}

# Firebase Service Account Files
.*firebase.*adminsdk.*\.json

# Generic API Keys
api[_-]?key['\"]?\s*[:=]\s*['\"][0-9a-zA-Z]{32,}['\"]

# Database URLs with credentials
mongodb(\+srv)?:\/\/[^:]+:[^@]+@

# JWT Tokens
eyJ[a-zA-Z0-9_-]*\.eyJ[a-zA-Z0-9_-]*\.[a-zA-Z0-9_-]*

# Generic Secrets
(secret|password|pwd|token)['\"]?\s*[:=]\s*['\"][^'\"]{8,}['\"]
