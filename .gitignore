
# Ignore the Firebase Admin SDK service account JSON file
cookie-gallery-firebase-adminsdk.json

# Dependency directories
# These can be regenerated by running `npm install`
node_modules/
backend/node_modules/

# Environment variables
# Contains sensitive keys and should never be committed.
# This covers .env, .env.local, .env.production, etc. for the frontend
.env*
# Explicitly ignore the backend's .env file
src/backend/.env
src/backend/*.env
src/backend/*.env.*
src/backend/*-firebase-adminsdk*.json
src/backend/serviceAccount*.json
src/backend/firebase-admin-sdk.json


# Build output
# This is generated code, not source code
dist/
build/
out/
*.tsbuildinfo
.dockerignore

# Logs
# Logs are machine-specific and not part of the source code
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
src/backend/*.log

# Operating System generated files
.DS_Store
Thumbs.db
*:Zone.Identifier

# npm cache (accidentally created on Windows)
C:\npm-cache/
npm-cache/

# IDE and editor directories
# These are user-specific editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Playwright reports and traces
playwright-report/
test-results/
results/

# Performance test results
performance/results/*.json
performance/results/*.html

# Vite build output
dist

# Log files
vite.log

# Documentation files (local notes)
*.md
!README.md

# Video files
*.mp4
*.mov
*.avi
C:\npm-cache
C:\npm-cache/
**/C:\npm-cache/
C:\npm-cache/
**/C:\npm-cache/
C:\\npm-cache/
**/C:\\npm-cache/
npm-cache/
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
service-account*.json
GCP.json
__pycache__/
*.pyc
.venv/
venv/
.next/
coverage/
