# Run lint-staged
npx lint-staged

# Run git-secrets scan if available
if command -v git-secrets >/dev/null 2>&1; then
  git secrets --scan
else
  echo "⚠️  git-secrets not installed. Run: brew install git-secrets (macOS) or apt-get install git-secrets (Linux)"
  echo "⚠️  Skipping secrets scan..."
fi
