{
  "name": "cookie-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:frontend": "vitest run src --exclude=src/backend",
    "test:backend": "cd src/backend && npm test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "test:staged": "vitest related --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "perf:health": "k6 run performance/health-check.test.js",
    "perf:webhook": "k6 run performance/webhook-load.test.js",
    "perf:checkout": "k6 run performance/checkout-flow.test.js",
    "perf:smoke": "k6 run --vus 1 --duration 30s performance/health-check.test.js",
    "perf:all": "npm run perf:health && npm run perf:webhook && npm run perf:checkout",
    "optimize:images": "node scripts/optimize-images.js"
  },
  "dependencies": {
    "@heroui/react": "^2.8.5",
    "@sentry/react": "^10.25.0",
    "@sentry/vite-plugin": "^4.6.0",
    "@stripe/react-stripe-js": "^5.2.0",
    "@stripe/stripe-js": "^8.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/styled-components": "^5.1.35",
    "@vercel/analytics": "^1.6.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.23.7",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "stripe": "^19.1.0",
    "styled-components": "^6.1.19",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.30.1",
    "@pact-foundation/pact": "^16.0.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.0",
    "clsx": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-imagetools": "^9.0.0",
    "vitest": "^2.1.9"
  }
}
