# ===================================
# Backend Environment Variables
# ===================================
# Copy this file to .env and fill in your actual values

# Stripe Configuration (Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Sentry Configuration (Get from https://sentry.io)
SENTRY_DSN_BACKEND=https://your-sentry-backend-dsn@sentry.io/project-id
# Optional legacy variable for backwards compatibility
SENTRY_DSN=https://your-sentry-backend-dsn@sentry.io/project-id

# Alerting
SLACK_SENTRY_ALERT_WEBHOOK=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# Razorpay Configuration (if using Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Credentials (Get from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_private_key_here\n-----END PRIVATE KEY-----\n"

# Optional: API Security
# API_SHARED_SECRET=your-strong-shared-secret-here

# Server Configuration
PORT=5000
NODE_ENV=development
